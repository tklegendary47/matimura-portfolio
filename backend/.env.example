# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string (create a free cluster at mongodb.com/atlas)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/matimura?retryWrites=true&w=majority

# Port the API server runs on
PORT=3000

# A private key you invent yourself — required in the header when adding/editing
# projects through the API (protects the write endpoints). Treat like a password.
ADMIN_API_KEY=change-this-to-something-only-you-know

# Optional: lets the contact form email you directly when someone submits it.
# Leave blank to just store submissions in MongoDB without emailing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=you@example.com

# Comma-separated list of frontend origins allowed to call this API when the
# frontend is hosted separately from the backend (e.g. Netlify + Render).
# Not needed if the backend serves the frontend itself (see server.js).
ALLOWED_ORIGINS=https://your-portfolio-domain.com
